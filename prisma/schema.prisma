generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model notes {
  id      String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id String @db.Uuid
  note    String
  users   users  @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_notes_user")
}

model payments {
  stripe_payment_intent_id String  @id @db.VarChar(255)
  stripe_charge_id         String? @db.VarChar(255)
  receipt_url              String?
  amount                   Int
  status                   String  @db.VarChar(50)
}

model users {
  id                 String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  auth_user_id       String            @unique @db.VarChar(255)
  name               String            @db.VarChar(255)
  stripe_customer_id String?           @db.VarChar(255)
  notes              notes[]
}
